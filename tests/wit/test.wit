package test:wasi;

world wasi-random {
    import wasi:random/random@0.2.12;

    export get-random-u64: func() -> u64;
    export get-random-bytes: func(len: u32) -> list<u8>;
}

// For the `webcrypto` polyfill tests (tests/webcrypto.rs) - `run` is async
// because crypto.subtle's methods are all Promise-returning.
world webcrypto-test {
    import wasi:random/random@0.2.12;

    export run: async func() -> string;
}

world webcrypto-no-random {
    export run: async func() -> string;
}

// For the setTimeout/setInterval polyfill tests (tests/timers.rs).
world timers-test {
    import wasi:clocks/monotonic-clock@0.3.0;

    export run: async func() -> string;
}

world timers-no-clock {
    export run: async func() -> string;
}

// For the fetch() polyfill tests (tests/fetch.rs).
world fetch-test {
    import wasi:http/client@0.3.0;

    export run: async func() -> string;
}

world fetch-no-client {
    export run: async func() -> string;
}

world wasi-clocks {
    import wasi:clocks/monotonic-clock@0.2.12;

    export get-time-ns: func() -> u64;
    export elapsed-ns: func() -> u64;
}

world wasi-environment {
    import wasi:cli/environment@0.2.12;

    export get-env-vars: func() -> list<tuple<string, string>>;
}

world wasi-stdio {
    import wasi:cli/stdin@0.2.12;
    import wasi:cli/stdout@0.2.12;
    import wasi:io/streams@0.2.12;

    export echo-stdin-to-stdout: func() -> result;
}

world wasi-import-types {
    import wasi:filesystem/types@0.2.12;

    export check-import-types: func() -> bool;
}

world wasi-stdin-drop {
    import wasi:cli/stdin@0.2.12;

    export test-drop: func() -> bool;
}

// `wasi:http/proxy` re-exports wasi:io/streams' input-stream/output-stream,
// wasi:io/poll's pollable, and wasi:io/error's error (aliased as
// `io-error`) through wasi:http/types' `use` statements. Regression coverage
// for the resource-identity bug where componentize's WASI-import stub gave
// each occurrence of these resources a fresh, unrelated host type instead of
// reusing whatever `wasmtime_wasi::p2::add_to_linker_async` later registers
// for the wasi:io/* originals — see `known_wasi_io_resource` in
// crates/core/src/lib.rs.
world wasi-http-proxy {
    include wasi:http/proxy@0.2.12;
}
