{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "hono",
    "fetch-provider"
  ],
  "_comment": "hono/ and fetch-provider/ have their own tsconfig (they need the DOM lib and npm deps)"
}
